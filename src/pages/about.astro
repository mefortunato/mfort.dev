---
import Base from '../layouts/Base.astro';

// TODO: replace with real names, roles and bios.
const founders = [
  {
    initials: 'M',
    name: 'Founder One',
    role: 'Software & Systems',
    bio: 'Builds the apps, tools and automations behind mfort. Happiest when a prototype ships before lunch.',
  },
  {
    initials: 'F',
    name: 'Founder Two',
    role: 'Brand & Content',
    bio: 'Leads marketing, storytelling and social. Gives every project a real voice and point of view.',
  },
];

const principles = [
  {
    title: 'Taste first',
    text: 'Every release, post and campaign gets our own eyes and judgment before it goes out.',
  },
  {
    title: 'Small on purpose',
    text: 'Two people, a few good tools, and projects we actually care about. We like it that way.',
  },
  {
    title: 'Modern tools, used openly',
    text: 'We use whatever helps us make better work, AI included, and we are upfront about it.',
  },
  {
    title: 'Ship, then sharpen',
    text: 'Fast iteration beats perfect plans. We release early, listen closely, and let the feedback loop do its work.',
  },
];
---

<Base title="About" description="Who's behind mfort, the two-person studio building apps, brands and content.">
  <section class="section page-hero">
    <div class="container">
      <span class="eyebrow">About mfort</span>
      <h1>A family studio for <span class="gradient-text">things we love making</span>.</h1>
      <p class="lead">
        mfort is the umbrella for the projects we build together as a couple: apps, marketing experiments
        and content. It gives our side projects a shared home and a little more ambition.
      </p>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="founders">
        {
          founders.map((f) => (
            <article class="card founder reveal">
              <div class="avatar" aria-hidden="true">{f.initials}</div>
              <div>
                <h2 class="h3">{f.name}</h2>
                <p class="role">{f.role}</p>
                <p class="muted">{f.bio}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Principles</span>
        <h2>How we work</h2>
      </div>
      <div class="principles">
        {
          principles.map((p, i) => (
            <div class="principle reveal">
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p class="muted">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="cta-line reveal">
        <p>Curious about something we're building?</p>
        <a class="btn btn-primary" href="/contact/">Say hello</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    padding-bottom: 2rem;
  }
  .page-hero h1 {
    max-width: 16ch;
  }
  .tight {
    padding-block: 2rem;
  }
  .section-head {
    margin-bottom: 2.5rem;
  }
  .h3 {
    font-size: 1.3rem;
    margin-bottom: 0.2rem;
  }
  .founders {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .founder {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .founder p:last-child {
    margin-bottom: 0;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #1a8fb0, #0d5b73);
    box-shadow: 0 10px 30px -10px var(--accent-glow);
  }
  .role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-text);
    margin-bottom: 0.75rem;
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 3rem;
  }
  .principle {
    padding-left: 1.25rem;
    border-left: 2px solid var(--border-strong);
  }
  .idx {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-text);
  }
  .principle h3 {
    margin-top: 0.3rem;
  }
  .cta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--border);
  }
  .cta-line p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
  }
  @media (max-width: 960px) {
    .founders {
      grid-template-columns: 1fr;
    }
    .founder {
      flex-direction: row;
      align-items: flex-start;
    }
    .avatar {
      flex-shrink: 0;
    }
  }
  @media (max-width: 640px) {
    .principles {
      grid-template-columns: 1fr;
    }
    .founder {
      flex-direction: column;
    }
  }
</style>
