---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { activeSocials, activities, site } from '../data/site';
---

<Base>
  <section class="container page">
    <div class="identity">
      <Logo size={48} />
      <h1>{site.legalName}</h1>
    </div>

    <p class="summary">
      A small, family-run company that is home to our projects in software, digital marketing, and social
      media content.
    </p>

    <section aria-labelledby="work-heading">
      <h2 id="work-heading">What we do</h2>
      <dl class="activities">
        {
          activities.map((a) => (
            <div>
              <dt>{a.title}</dt>
              <dd>{a.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact</h2>
      <ul class="contact">
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        {
          activeSocials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                <SocialIcon name={s.key} size={16} />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    padding-block: clamp(2rem, 10vh, 6rem) 2rem;
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 2.75rem);
  }
  .summary {
    margin: 0;
    font-size: 1.15rem;
    color: var(--text-muted);
  }
  h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 1rem;
  }
  .activities {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--border);
  }
  .activities > div {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--border);
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
    color: var(--text-muted);
  }
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  @media (max-width: 520px) {
    .activities > div {
      grid-template-columns: 1fr;
    }
  }
</style>
