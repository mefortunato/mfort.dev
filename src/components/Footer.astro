---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>© {year} {site.legalName}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem;
  }
  p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-faint);
  }
</style>
